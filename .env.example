# Required: your Anthropic API key. Get one at https://console.anthropic.com/
# NEVER commit the real value or expose it in client-side code -- it is only
# ever read server-side, inside app/api/*/route.ts.
ANTHROPIC_API_KEY=

# Model to use for chat responses.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: cap on requests per session per minute (basic in-memory rate limit).
RATE_LIMIT_PER_MINUTE=20
